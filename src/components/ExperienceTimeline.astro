---
// Experience timeline for the About page. Content is the owner's own list, in order.
// No dates or years: the order is the story. Phase labels group the entries.
// Every entry has the same shape: bold college or company, area bullets, then a
// "Programming" disclosure with the languages and tech (owner's list, in order).
interface Entry {
	org: string;
	place?: string;
	areas: string[];
	programming: string[];
}

interface Phase {
	label: string;
	entries: Entry[];
}

const phases: Phase[] = [
	{
		label: "Build",
		entries: [
			{
				org: "College",
				place: "NIT Bhopal",
				areas: ["WordPress", "Entrepreneurship"],
				programming: ["PHP", "HTML", "CSS", "JS"],
			},
		],
	},
	{
		label: "Industry",
		entries: [
			{ org: "Amdocs", place: "Pune", areas: ["QA automation", "Telecom"], programming: ["Java"] },
			{
				org: "Adobe",
				areas: ["Software Engineer", "Enterprise YouTube with CQ5"],
				programming: ["Java", "Python"],
			},
		],
	},
	{
		label: "Startups",
		entries: [{ org: "Startups", areas: ["Entrepreneurship"], programming: ["Node.js", "MongoDB"] }],
	},
	{
		label: "Google",
		entries: [
			{ org: "Google India", areas: ["GPay Offers"], programming: ["Java", "Flume", "Spanner"] },
			{
				org: "Google US",
				areas: ["Cloud Run", "Android Auto Assistant", "YouTube Commerce"],
				programming: ["Java", "Go", "GCL", "C++"],
			},
		],
	},
	{
		label: "AI",
		entries: [{ org: "Lyra Health", areas: ["AI / ML"], programming: ["Kotlin", "Python", "Rust"] }],
	},
];
---
<section class="xp text-90" aria-labelledby="xp-heading">
	<div class="xp-head">
		<h2 id="xp-heading" class="xp-heading">Experience</h2>
		<button type="button" class="xp-all" aria-expanded="false" data-xp-all>
			<svg class="xp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m16 18 6-6-6-6" /><path d="m8 6-6 6 6 6" /></svg>
			<span data-xp-all-label>Show programming</span>
		</button>
	</div>
	<noscript><style>.xp-all { display: none; }</style></noscript>
	{phases.map((phase, pi) => (
		<section class="xp-phase" aria-labelledby={`xp-phase-${pi}`}>
			<h3 id={`xp-phase-${pi}`} class="xp-label">{phase.label}</h3>
			<ol class="xp-list" role="list" start={phases.slice(0, pi).reduce((n, ph) => n + ph.entries.length, 1)}>
				{phase.entries.map((entry) => (
					<li class="xp-item">
						<h4 class="xp-title">
							<strong class="xp-org">{entry.org}</strong>
							{entry.place && <span class="xp-place">{entry.place}</span>}
						</h4>
						<ul class="xp-areas" role="list">
							{entry.areas.map((area) => <li class="xp-area">{area}</li>)}
						</ul>
						<details class="xp-prog" data-xp-prog>
							<summary class="xp-prog-toggle">
								<svg class="xp-icon xp-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
								Programming
							</summary>
							<ul class="xp-chips" role="list" aria-label={`Programming at ${entry.org}`}>
								{entry.programming.map((tech) => <li class="xp-chip">{tech}</li>)}
							</ul>
						</details>
					</li>
				))}
			</ol>
		</section>
	))}
</section>

<script>
	// Delegated once at document level, so it keeps working across Swup page swaps.
	const sync = (root: ParentNode) => {
		const btn = root.querySelector<HTMLButtonElement>("[data-xp-all]");
		if (!btn) return;
		const all = [...root.querySelectorAll<HTMLDetailsElement>("[data-xp-prog]")];
		const open = all.length > 0 && all.every((d) => d.open);
		btn.setAttribute("aria-expanded", String(open));
		const label = btn.querySelector("[data-xp-all-label]");
		if (label) label.textContent = open ? "Hide programming" : "Show programming";
	};
	document.addEventListener("click", (e) => {
		const btn = (e.target as Element | null)?.closest<HTMLButtonElement>("[data-xp-all]");
		const root = btn?.closest(".xp");
		if (!btn || !root) return;
		const open = btn.getAttribute("aria-expanded") !== "true";
		for (const d of root.querySelectorAll<HTMLDetailsElement>("[data-xp-prog]")) d.open = open;
		sync(root);
	});
	document.addEventListener(
		"toggle",
		(e) => {
			const root = (e.target as Element | null)?.closest?.(".xp");
			if (root) sync(root);
		},
		true,
	);
</script>

<style>
	.xp {
		margin-top: 2.5rem;
	}
	.xp-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 1rem;
	}
	.xp-heading {
		font-size: 1.5rem;
		font-weight: 700;
	}
	.xp-icon {
		width: 1rem;
		height: 1rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.xp-all,
	.xp-prog-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2rem;
		padding: 0 0.75rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--btn-content);
		cursor: pointer;
	}
	.xp-all {
		background: var(--btn-regular-bg);
	}
	.xp-all:hover {
		background: var(--btn-regular-bg-hover);
	}
	.xp-all:active {
		background: var(--btn-regular-bg-active);
	}
	.xp-all:focus-visible,
	.xp-prog-toggle:focus-visible {
		outline: 2px solid var(--btn-content);
		outline-offset: 2px;
	}
	.xp-phase {
		margin-top: 1.75rem;
	}
	.xp-label {
		font-size: max(0.75rem, 12px);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--btn-content);
		margin-bottom: 0.75rem;
	}
	.xp-list {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.25rem;
		border-left: 2px solid color-mix(in srgb, currentColor 22%, transparent);
	}
	.xp-item {
		position: relative;
		padding-bottom: 1.25rem;
	}
	.xp-item:last-child {
		padding-bottom: 0;
	}
	.xp-item::before {
		content: "";
		position: absolute;
		left: calc(-1.25rem - 6px);
		top: 0.4rem;
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 3px var(--page-bg);
	}
	.xp-title {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.5rem;
		font-size: 1rem;
		font-weight: 400;
		overflow-wrap: anywhere;
	}
	.xp-org {
		font-weight: 700;
	}
	.xp-place {
		font-size: 0.875rem;
		opacity: 0.75;
	}
	.xp-areas {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0 0 0 1rem;
	}
	.xp-area {
		position: relative;
		font-size: 0.9rem;
		padding: 0.125rem 0;
	}
	.xp-area::before {
		content: "";
		position: absolute;
		left: calc(-1rem + 1px);
		top: 0.7rem;
		width: 5px;
		height: 5px;
		border-radius: 999px;
		background: currentColor;
		opacity: 0.5;
	}
	.xp-prog {
		margin-top: 0.375rem;
	}
	.xp-prog-toggle {
		list-style: none;
		margin-left: -0.75rem;
	}
	.xp-prog-toggle::-webkit-details-marker {
		display: none;
	}
	.xp-prog-toggle:hover {
		background: var(--btn-regular-bg);
	}
	.xp-chevron {
		transition: transform 0.15s ease;
	}
	.xp-prog[open] .xp-chevron {
		transform: rotate(90deg);
	}
	.xp-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}
	.xp-chip {
		display: inline-flex;
		align-items: center;
		min-height: 1.5rem;
		padding: 0.125rem 0.625rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
	}
	@media (prefers-reduced-motion: reduce) {
		.xp-chevron {
			transition: none;
		}
	}
	@media (min-width: 768px) {
		.xp-phase {
			display: grid;
			grid-template-columns: 11rem 1fr;
			column-gap: 1.5rem;
			align-items: start;
		}
		.xp-label {
			margin-bottom: 0;
			padding-top: 0.15rem;
		}
	}
</style>
