---
import { Icon } from "astro-icon/components";
import { url } from "@utils/url-utils";

interface Props {
	class?: string;
}
const className = Astro.props.class;
---
<aside class:list={["lic", className]} aria-label="Copyright and license">
	<p class="lic-copy">© {new Date().getFullYear()} Ning Waikhom. All rights reserved.</p>
	<p class="lic-perm">Research and experiments on this site may not be reused, copied, republished or used to train models without my written permission.</p>
	<p class="lic-quote">Short quotes with attribution and a link are fine.</p>
	<a class="lic-link" href={url("/license/")}>
		<Icon name="lucide:scale" aria-hidden="true" />
		License
	</a>
</aside>

<style>
	/* Same look as the standalone footer band (src/integrations/standalone-header.ts): keep them in step. */
	.lic {
		--lic-rule: rgba(0, 0, 0, 0.12);
		--lic-strong: #1d2228;
		--lic-body: #3d444d;
		--lic-muted: #5b626b;
		--lic-accent: oklch(0.5 0.12 var(--hue));
		--lic-hover: oklch(0.95 0.03 var(--hue));
		position: relative;
		padding: 1.5rem 0 0.25rem;
		border-top: 1px solid var(--lic-rule);
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--lic-body);
		overflow-wrap: anywhere;
	}
	:global(.dark) .lic {
		--lic-rule: rgba(255, 255, 255, 0.14);
		--lic-strong: rgba(255, 255, 255, 0.92);
		--lic-body: #c9ced6;
		--lic-muted: #a7aeb8;
		--lic-accent: oklch(0.75 0.1 var(--hue));
		--lic-hover: oklch(0.3 0.04 var(--hue));
	}
	.lic::before {
		content: "";
		position: absolute;
		top: -1px;
		left: 0;
		width: 3rem;
		height: 2px;
		background: var(--lic-accent);
	}
	.lic p {
		max-width: 60ch;
		margin: 0.5rem 0 0;
	}
	.lic > .lic-copy {
		margin: 0;
		font-weight: 600;
		font-size: 1rem;
		color: var(--lic-strong);
	}
	.lic-quote {
		font-size: 0.875rem;
		color: var(--lic-muted);
	}
	.lic-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		min-height: 2.75rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--lic-accent);
		border-radius: 0.5rem;
		color: var(--lic-strong);
		font-weight: 500;
		text-decoration: none;
	}
	.lic-link:hover {
		background: var(--lic-hover);
	}
	.lic-link:focus-visible {
		outline: 2px solid var(--lic-accent);
		outline-offset: 3px;
	}
	.lic-link svg {
		width: 1.125rem;
		height: 1.125rem;
		flex: none;
		color: var(--lic-accent);
	}
	@media (max-width: 767px) {
		.lic {
			padding-inline: 1rem;
		}
		.lic::before {
			left: 1rem;
		}
	}
</style>
