---
import { url } from "@utils/url-utils";
// Listen player for every post (see src/scripts/tts). Ships hidden: the script shows it only when an engine can run,
// so without JavaScript nothing renders. Opt out per post with `noListen: true` in front matter.
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
}
const { title } = Astro.props;
// Where ONNX Runtime Web is served from. Set PUBLIC_KOKORO_ORT_BASE at build time to point at a CDN instead.
const kokoroOrtBase = import.meta.env.PUBLIC_KOKORO_ORT_BASE ?? url("/tts/vendor/ort/");
---

<script is:inline>
	// Neural voice switch. Off until the owner decides how the ONNX Runtime files and the 4.6 MB lexicon ship
	// (vendored under public/tts vs CDN + SRI). Turn on only with public/tts/vendor/ort and lexicon-en-us.txt deployed.
	var KOKORO_ENABLED = false;
	// CPU tier (q8f16 on wasm): off until fp16 on wasm is verified. It returns NaN chunks for some inputs today.
	window.__KOKORO_CPU = false;
	// Offers the neural voice only where it can run: WebAssembly, BigInt64Array (int64 model inputs), DecompressionStream (lexicon).
	// A value set before this script runs wins (check:listen forces it to test the consent path); otherwise the switch decides.
	if (window.__KOKORO_READY === undefined) window.__KOKORO_READY = KOKORO_ENABLED && typeof WebAssembly === "object" && typeof BigInt64Array === "function" && typeof DecompressionStream === "function";
</script>
<listen-player hidden data-target="#post-article" data-title={title} data-kokoro-src={url("/tts/kokoro.js")} data-kokoro-ort={kokoroOrtBase}>
	<div class="listen-bar">
		<button type="button" class="listen-btn listen-toggle" data-toggle aria-expanded="false" aria-controls="listen-panel">
			<Icon name="lucide:headphones" class="listen-headphones" />
			<span>Listen</span>
			<Icon name="lucide:chevron-down" class="listen-chevron" />
		</button>
		<button type="button" class="listen-btn listen-play" data-action="play" aria-label="Play">
			<span data-icon-play><Icon name="lucide:play" /></span>
			<span data-icon-pause hidden><Icon name="lucide:pause" /></span>
		</button>
		<button type="button" class="listen-btn" data-action="prev" aria-label="Previous sentence">
			<Icon name="lucide:skip-back" />
		</button>
		<button type="button" class="listen-btn" data-action="next" aria-label="Next sentence">
			<Icon name="lucide:skip-forward" />
		</button>
		<input type="range" class="listen-range" data-progress min="0" max="0" value="0" aria-label="Sentence in this post" />
		<span class="listen-pos" data-position>0 / 0</span>
		<button type="button" class="listen-btn" data-follow hidden aria-label="Show the sentence being read">
			<Icon name="lucide:locate-fixed" />
		</button>
	</div>

	<div id="listen-panel" class="listen-panel">
		<label class="listen-field" data-voice-wrap>
			<span>Voice</span>
			<select data-voice class="listen-select"></select>
		</label>
		<label class="listen-field listen-rate">
			<span>Speed</span>
			<select data-rate class="listen-select" aria-label="Speed"></select>
		</label>
		<label class="listen-field" data-engine-wrap hidden>
			<span>Engine</span>
			<select data-engine class="listen-select">
				<option value="web-speech">Built-in voice</option>
			</select>
		</label>
		<p class="listen-note">
			<span data-note-local>Realtime audio generated on your device<sup data-accel hidden></sup>. Nothing is uploaded.</span>
			<span class="listen-credit" data-notice hidden></span>
			<span data-note-remote hidden>This voice is a remote service: the sentence text is sent to it.</span>
		</p>
		<p class="listen-status" data-status aria-live="polite"></p>
	</div>

	<dialog class="listen-dialog" data-consent aria-labelledby="listen-consent-title">
		<form method="dialog">
			<h2 id="listen-consent-title">Download a neural voice?</h2>
			<p>The model comes from Hugging Face, is downloaded once and cached in your browser, and runs on your device. Nothing you read is uploaded. Downloads include the voice runtime and pronunciation list.</p>
			<ul class="listen-variants">
				<li><strong>Fast: GPU</strong>, about 355 MB. Uses WebGPU; runs faster than real time.</li>
				<li><strong>Light: CPU</strong>, about 105 MB. Works without WebGPU; may pause between sentences.</li>
			</ul>
			<p class="listen-credit">Speech by Kokoro-82M (hexgrad, Apache-2.0), ONNX export by onnx-community. Training data includes Koniwa (CC BY 3.0) and SIWIS (CC BY 4.0).</p>
			<menu>
				<button type="submit" value="cancel" class="listen-btn listen-text">Cancel</button>
				<button type="submit" value="q8f16" class="listen-btn" data-variant="q8f16">Light: CPU</button>
				<button type="submit" value="fp32" class="listen-btn listen-primary" data-variant="fp32">Fast: GPU</button>
			</menu>
		</form>
	</dialog>
</listen-player>

<script>
	import "../scripts/tts/listen-player";
</script>

<style is:global>
	listen-player {
		display: block;
		position: sticky;
		top: env(safe-area-inset-top, 0px);
		z-index: 20;
		margin-bottom: 1.25rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
		background: var(--card-bg);
		color: rgb(0 0 0 / 0.78);
	}
	.dark listen-player {
		color: rgb(255 255 255 / 0.86);
	}
	listen-player[hidden],
	listen-player [hidden] {
		display: none !important;
	}
	.listen-bar {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem 0.625rem;
	}
	.listen-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		min-width: 2.25rem;
		height: 2.25rem;
		padding: 0 0.5rem;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: inherit;
		font-size: 0.875rem;
		cursor: pointer;
		flex: none;
	}
	.listen-btn:hover {
		background: var(--btn-regular-bg-hover);
	}
	.listen-btn:active {
		background: var(--btn-regular-bg-active);
	}
	.listen-btn:focus-visible,
	.listen-select:focus-visible,
	.listen-range:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.listen-play {
		background: var(--primary);
		color: oklch(0.2 0.02 var(--hue));
	}
	.listen-play:hover {
		filter: brightness(1.08);
	}
	.listen-toggle {
		padding: 0 0.75rem;
	}
	.listen-toggle [data-icon] {
		width: 1rem;
		height: 1rem;
	}
	.listen-chevron {
		transition: transform 0.2s ease;
	}
	listen-player[data-open] .listen-chevron {
		transform: rotate(180deg);
	}
	.listen-range {
		display: none;
		flex: 1;
		min-width: 0;
		accent-color: var(--primary);
	}
	.listen-pos {
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
		white-space: nowrap;
		margin-left: auto;
	}
	.listen-panel {
		display: none;
		flex-direction: column;
		gap: 0.625rem;
		padding: 0.25rem 0.75rem 0.75rem;
		border-top: 1px dashed var(--line-divider);
	}
	listen-player[data-open] .listen-panel {
		display: flex;
	}
	.listen-field {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
	}
	.listen-field > span {
		width: 4.5rem;
		opacity: 0.7;
	}
	.listen-select {
		flex: 1;
		min-width: 0;
		height: 2.25rem;
		padding: 0 0.5rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: inherit;
		font-size: 0.875rem;
	}
	.listen-note,
	.listen-status {
		margin: 0;
		font-size: 0.8125rem;
		opacity: 0.75;
	}
	.listen-status:empty {
		display: none;
	}
	.listen-note sup {
		font-size: 0.65em;
		font-weight: 600;
		color: var(--primary);
		margin-left: 0.125rem;
	}
	.listen-dialog {
		border: 0;
		border-radius: 0.75rem;
		padding: 1.25rem;
		max-width: min(26rem, calc(100vw - 2rem));
		background: var(--card-bg);
		color: inherit;
	}
	.listen-dialog::backdrop {
		background: rgb(0 0 0 / 0.4);
	}
	.listen-dialog h2 {
		margin: 0 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 700;
	}
	.listen-dialog p {
		margin: 0 0 1rem;
		font-size: 0.9375rem;
		line-height: 1.5;
	}
	.listen-dialog menu {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
	}
	.listen-primary {
		background: var(--primary);
		color: oklch(0.2 0.02 var(--hue));
	}
	.listen-text {
		background: transparent;
	}
	.listen-dialog .listen-btn {
		min-width: 0;
	}

	@media (min-width: 768px) {
		.listen-toggle {
			display: none;
		}
		.listen-range {
			display: block;
		}
		.listen-panel {
			display: flex;
			border-top: 0;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.5rem 1.25rem;
			padding-top: 0;
		}
		.listen-field {
			width: auto;
		}
		.listen-field:first-child {
			flex: 1 1 14rem;
		}
		.listen-note,
		.listen-status {
			width: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.listen-chevron,
		.listen-btn {
			transition: none;
		}
	}

	::highlight(listen-current) {
		background-color: color-mix(in oklch, var(--primary) 26%, transparent);
		color: inherit;
	}
	/* Fallback where the CSS Custom Highlight API is missing. */
	.listen-active {
		box-shadow: inset 3px 0 0 var(--primary);
		border-radius: 2px;
	}

	/* Docked: once the post scrolls past the player it pins flush to the top of the viewport as one slim row.
	   The controls it hides (voice, slider, engine, notes) open in a dropdown under the row. The script moves
	   the speed and slider elements between the row and the dropdown. The sentinel just above the player tells
	   the script when to dock; the player keeps its flow height (margin compensation), so nothing below shifts. */
	.listen-sentinel {
		height: 0;
	}
	/* scrollIntoView lands the sentence below the docked row. */
	[data-listen-current] {
		scroll-margin-top: 4.5rem;
	}
	listen-player[data-docked] {
		height: 2.5rem;
		margin-inline: -1.5rem;
		border: 0;
		border-bottom: 1px solid var(--line-divider);
		border-radius: 0;
		background: var(--card-bg);
	}
	listen-player[data-docked] .listen-bar {
		height: 100%;
		gap: 0.25rem;
		padding: 0 0.5rem;
	}
	listen-player[data-docked] .listen-btn {
		height: 2rem;
		min-width: 2rem;
		padding: 0 0.375rem;
	}
	listen-player[data-docked] .listen-toggle {
		display: inline-flex;
		order: 2;
	}
	listen-player[data-docked] .listen-toggle > span,
	listen-player[data-docked] .listen-headphones {
		display: none;
	}
	listen-player[data-docked] .listen-rate {
		flex: none;
		width: auto;
	}
	listen-player[data-docked] .listen-rate > span {
		display: none;
	}
	listen-player[data-docked] .listen-rate .listen-select {
		flex: none;
		width: auto;
		height: 2rem;
		padding: 0 0.375rem;
		font-size: 0.8125rem;
	}
	listen-player[data-docked] .listen-pos {
		font-size: 0.75rem;
	}
	listen-player[data-docked]:not([data-open]) .listen-panel {
		display: none;
	}
	listen-player[data-docked] .listen-panel {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		flex-wrap: nowrap;
		gap: 0.625rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--line-divider);
		border-top: 1px dashed var(--line-divider);
		border-radius: 0 0 0.75rem 0.75rem;
		background: var(--card-bg);
		box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
	}
	listen-player[data-docked] .listen-panel .listen-field,
	listen-player[data-docked] .listen-panel .listen-range {
		flex: none;
		width: 100%;
	}
	listen-player[data-docked] .listen-range {
		display: block;
	}
	listen-player[data-docked] .listen-panel .listen-field:first-child {
		flex: none;
	}
	@media (min-width: 768px) {
		listen-player[data-docked] {
			margin-inline: -2.25rem;
		}
	}
</style>
