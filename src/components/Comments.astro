---
import { commentConfig } from "@/config";

// Render nothing unless comments are enabled and the Giscus IDs are present.
const enabled =
	commentConfig.enable &&
	!!commentConfig.repo &&
	!!commentConfig.repoId &&
	!!commentConfig.categoryId;
---

{enabled && (
	<div id="giscus-comments" class="giscus-host mb-6 onload-animation" aria-busy="true">
		<!-- Holds the widget's space until Giscus reports its first height, so the page never jumps or flashes. -->
		<div class="giscus-skeleton" aria-hidden="true">
			<div class="giscus-skeleton-reactions">
				<span class="skeleton" style="width: 6.5rem; height: 1.25rem"></span>
				<span class="skeleton" style="width: 2rem; height: 2rem; border-radius: 9999px"></span>
			</div>
			<span class="skeleton giscus-skeleton-count"></span>
			<div class="giscus-skeleton-box">
				<div class="giscus-skeleton-tabs">
					<span class="skeleton"></span>
					<span class="skeleton"></span>
				</div>
				<span class="skeleton giscus-skeleton-input"></span>
				<span class="skeleton giscus-skeleton-button"></span>
			</div>
		</div>
		<!-- Shown instead of the widget when giscus fails; keeps the skeleton's height so nothing below moves. -->
		<div class="giscus-unavailable text-75" role="status" hidden>
			<p>Comments could not load right now. Try again later.</p>
			<p class="giscus-unavailable-actions">
				<button type="button" class="giscus-retry btn-regular">Try again</button>
				<a href={`https://github.com/${commentConfig.repo}/discussions`} rel="noopener">Open the discussions on GitHub</a>
			</p>
		</div>
		<noscript><style>.giscus-skeleton{display:none}</style></noscript>
	</div>
	<script is:inline define:vars={{
		repo: commentConfig.repo,
		repoId: commentConfig.repoId,
		category: commentConfig.category,
		categoryId: commentConfig.categoryId,
	}}>
		(function () {
			function giscusTheme() {
				return document.documentElement.classList.contains("dark") ? "dark" : "light";
			}
			function frame() {
				return document.querySelector("iframe.giscus-frame");
			}
			function syncTheme() {
				var f = frame();
				if (f) {
					f.contentWindow.postMessage(
						{ giscus: { setConfig: { theme: giscusTheme() } } },
						"https://giscus.app",
					);
				}
			}
			// Swap the skeleton for the widget (ok) or the notice (failed). Safe to call more than once; a failure wins
			// over an earlier ok (giscus can report an error after its first height).
			function settle(host, ok) {
				if (host.hasAttribute("data-failed") || (ok && host.hasAttribute("data-loaded"))) return;
				host.removeAttribute("aria-busy");
				clearTimeout(host.__giscusSettle);
				var skeleton = host.querySelector(".giscus-skeleton");
				var notice = host.querySelector(".giscus-unavailable");
				if (ok) {
					// The skeleton fades out (CSS) but stays in layout: the host never drops below the reserved height, even
					// while the lazy iframe still has its 150px default. A taller widget (with comments) grows past it.
					host.setAttribute("data-loaded", "");
				} else {
					// The notice takes the skeleton's height and the widget is hidden (CSS), so the page does not move.
					host.removeAttribute("data-loaded");
					host.setAttribute("data-failed", "");
					if (skeleton) skeleton.hidden = true;
					if (notice) notice.hidden = false;
				}
			}
			function mount() {
				var host = document.getElementById("giscus-comments");
				if (!host) return;
				var retry = host.querySelector(".giscus-retry");
				if (retry) retry.onclick = function () {
					host.removeAttribute("data-failed");
					host.setAttribute("aria-busy", "true");
					host.querySelector(".giscus-skeleton").hidden = false;
					host.querySelector(".giscus-unavailable").hidden = true;
					mount();
				};
				// Remove any existing giscus script/iframe so SPA navigation never duplicates the widget.
				document.querySelectorAll("script[data-giscus], iframe.giscus-frame").forEach(function (el) {
					el.remove();
				});
				// Defer the giscus bootstrap until the block is on screen: nothing fetches from giscus.app
				// before the reader scrolls to it. The retry button lives inside the block, so by the time it
				// is clicked the block is in view and the (fresh) observer fires immediately.
				function loadWidget() {
					var s = document.createElement("script");
					s.src = "https://giscus.app/client.js";
					s.async = true;
					s.crossOrigin = "anonymous";
					s.setAttribute("data-repo", repo);
					s.setAttribute("data-repo-id", repoId);
					s.setAttribute("data-category", category);
					s.setAttribute("data-category-id", categoryId);
					s.setAttribute("data-mapping", "pathname");
					s.setAttribute("data-strict", "0");
					s.setAttribute("data-reactions-enabled", "1");
					// Metadata tells us the discussion rendered (see the message listener).
					s.setAttribute("data-emit-metadata", "1");
					s.setAttribute("data-input-position", "top");
					s.setAttribute("data-theme", giscusTheme());
					s.setAttribute("data-lang", "en");
					s.setAttribute("loading", "lazy");
					s.setAttribute("data-giscus", "1");
					s.onerror = function () { settle(host, false); };
					host.appendChild(s);
				}
				if ("IntersectionObserver" in window) {
					var io = new IntersectionObserver(function (entries) {
						if (!entries[0].isIntersecting) return;
						io.disconnect();
						loadWidget();
						// The iframe loads lazily, so only time out once the comments are actually on screen.
						clearTimeout(host.__giscusTimeout);
						host.__giscusTimeout = setTimeout(function () {
							if (!host.hasAttribute("data-loaded")) settle(host, false);
						}, 30000);
					});
					io.observe(host);
				} else {
					loadWidget();
				}
			}

			mount();

			// Giscus messages from its iframe: discussion metadata means it rendered; "Discussion not found" is normal for a
			// post without comments yet (the empty widget still renders); any other error (an outage, a broken repo setup)
			// is a failure. Height reports alone settle after a short grace period, in case neither signal arrives.
			// Registered once per session; it always looks up the current host, so SPA navigations reuse it.
			if (!window.__giscusLoadListener) {
				window.__giscusLoadListener = true;
				window.addEventListener("message", function (e) {
					if (e.origin !== "https://giscus.app" || !e.data || typeof e.data !== "object" || !e.data.giscus) return;
					var host = document.getElementById("giscus-comments");
					if (!host) return;
					var g = e.data.giscus;
					if (g.error) settle(host, g.error === "Discussion not found");
					else if (g.discussion) settle(host, true);
					else if (g.resizeHeight && !host.__giscusSettle) {
						host.__giscusSettle = setTimeout(function () { host.__giscusSettle = 0; settle(host, true); }, 1500);
					}
				});
			}

			// Keep the widget in sync with the site's light/dark toggle. Registered once for the
			// whole session (guarded by a flag) so repeated SPA navigations don't stack observers.
			if (!window.__giscusThemeObserver) {
				window.__giscusThemeObserver = true;
				var mo = new MutationObserver(function () {
					syncTheme();
				});
				mo.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
			}
		})();
	</script>
)}

<style is:global>
	/* Skeleton and widget share one grid cell: the widget fades in on top, so nothing below it moves. */
	.giscus-host {
		display: grid;
	}
	.giscus-host > * {
		grid-area: 1 / 1;
		min-width: 0;
	}
	/* Mirrors the empty widget (reactions, count, comment box) at its measured height: 372px at 375 and 1440 px. */
	.giscus-skeleton {
		display: flex;
		flex-direction: column;
		height: 372px;
		transition: opacity 0.2s ease;
	}
	.giscus-skeleton-reactions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.giscus-skeleton .giscus-skeleton-count {
		width: 15rem;
		max-width: 100%;
		height: 1.25rem;
		margin: 2.5rem 0 1.25rem;
	}
	.giscus-skeleton-box {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.5rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.375rem;
	}
	.giscus-skeleton-tabs {
		display: flex;
		gap: 0.25rem;
	}
	.giscus-skeleton-tabs .skeleton {
		width: 4.25rem;
		height: 2.25rem;
	}
	.giscus-skeleton .giscus-skeleton-input {
		flex: 1;
	}
	.giscus-skeleton .giscus-skeleton-button {
		width: 11.5rem;
		height: 2rem;
		margin-left: auto;
	}
	.giscus-host[data-loaded] .giscus-skeleton {
		opacity: 0;
		pointer-events: none;
	}
	.giscus-host[data-failed] .giscus {
		display: none;
	}
	.giscus-unavailable {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		height: 372px;
		padding: 1rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.375rem;
		font-size: 0.875rem;
		text-align: center;
	}
	.giscus-unavailable[hidden] {
		display: none;
	}
	.giscus-unavailable p {
		margin: 0;
	}
	.giscus-unavailable-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.giscus-retry {
		min-height: 2.25rem;
		padding: 0 1rem;
		border-radius: 0.5rem;
		font-weight: 500;
		color: var(--btn-content);
	}
	.giscus-unavailable a {
		color: var(--btn-content);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.giscus-skeleton {
			transition: none;
		}
	}
</style>
