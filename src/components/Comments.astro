---
import { commentConfig } from "@/config";

// Render nothing unless comments are enabled and the Giscus IDs are present.
const enabled =
	commentConfig.enable &&
	!!commentConfig.repo &&
	!!commentConfig.repoId &&
	!!commentConfig.categoryId;
---

{enabled && (
	<div id="giscus-comments" class="giscus-host mb-6 onload-animation" aria-busy="true">
		<!-- Holds the widget's space until Giscus reports its first height, so the page never jumps or flashes. -->
		<div class="giscus-skeleton" aria-hidden="true">
			<div class="giscus-skeleton-reactions">
				<span class="skeleton" style="width: 6.5rem; height: 1.25rem"></span>
				<span class="skeleton" style="width: 2rem; height: 2rem; border-radius: 9999px"></span>
			</div>
			<span class="skeleton giscus-skeleton-count"></span>
			<div class="giscus-skeleton-box">
				<div class="giscus-skeleton-tabs">
					<span class="skeleton"></span>
					<span class="skeleton"></span>
				</div>
				<span class="skeleton giscus-skeleton-input"></span>
				<span class="skeleton giscus-skeleton-button"></span>
			</div>
		</div>
		<p class="giscus-unavailable" hidden>Comments could not load right now.</p>
		<noscript><style>.giscus-skeleton{display:none}</style></noscript>
	</div>
	<script is:inline define:vars={{
		repo: commentConfig.repo,
		repoId: commentConfig.repoId,
		category: commentConfig.category,
		categoryId: commentConfig.categoryId,
	}}>
		(function () {
			function giscusTheme() {
				return document.documentElement.classList.contains("dark") ? "dark" : "light";
			}
			function frame() {
				return document.querySelector("iframe.giscus-frame");
			}
			function syncTheme() {
				var f = frame();
				if (f) {
					f.contentWindow.postMessage(
						{ giscus: { setConfig: { theme: giscusTheme() } } },
						"https://giscus.app",
					);
				}
			}
			// Swap the skeleton for the widget (ok) or a short notice (failed). Safe to call more than once.
			function settle(host, ok) {
				if (host.hasAttribute("data-loaded")) return;
				host.removeAttribute("aria-busy");
				var skeleton = host.querySelector(".giscus-skeleton");
				var notice = host.querySelector(".giscus-unavailable");
				if (ok) {
					host.setAttribute("data-loaded", "");
					if (notice) notice.hidden = true;
					// Fade out, then drop it from layout so a short widget is not padded to the skeleton's height.
					if (skeleton) setTimeout(function () { skeleton.hidden = true; }, 250);
				} else if (!host.hasAttribute("data-failed")) {
					host.setAttribute("data-failed", "");
					if (skeleton) skeleton.hidden = true;
					if (notice) notice.hidden = false;
				}
			}
			function mount() {
				var host = document.getElementById("giscus-comments");
				if (!host) return;
				// Remove any existing giscus script/iframe so SPA navigation never duplicates the widget.
				document.querySelectorAll("script[data-giscus], iframe.giscus-frame").forEach(function (el) {
					el.remove();
				});
				var s = document.createElement("script");
				s.src = "https://giscus.app/client.js";
				s.async = true;
				s.crossOrigin = "anonymous";
				s.setAttribute("data-repo", repo);
				s.setAttribute("data-repo-id", repoId);
				s.setAttribute("data-category", category);
				s.setAttribute("data-category-id", categoryId);
				s.setAttribute("data-mapping", "pathname");
				s.setAttribute("data-strict", "0");
				s.setAttribute("data-reactions-enabled", "1");
				s.setAttribute("data-emit-metadata", "0");
				s.setAttribute("data-input-position", "top");
				s.setAttribute("data-theme", giscusTheme());
				s.setAttribute("data-lang", "en");
				s.setAttribute("loading", "lazy");
				s.setAttribute("data-giscus", "1");
				s.onerror = function () { settle(host, false); };
				host.appendChild(s);

				// The iframe loads lazily, so only time out once the comments are actually on screen.
				if ("IntersectionObserver" in window) {
					var io = new IntersectionObserver(function (entries) {
						if (!entries[0].isIntersecting) return;
						io.disconnect();
						setTimeout(function () {
							if (!host.hasAttribute("data-loaded")) settle(host, false);
						}, 30000);
					});
					io.observe(host);
				}
			}

			mount();

			// Giscus posts a message from its iframe once it has rendered (its first height report). Registered once
			// per session; it always looks up the current host, so SPA navigations reuse it.
			if (!window.__giscusLoadListener) {
				window.__giscusLoadListener = true;
				window.addEventListener("message", function (e) {
					if (e.origin !== "https://giscus.app" || !e.data || typeof e.data !== "object" || !e.data.giscus) return;
					var host = document.getElementById("giscus-comments");
					if (host) settle(host, true);
				});
			}

			// Keep the widget in sync with the site's light/dark toggle. Registered once for the
			// whole session (guarded by a flag) so repeated SPA navigations don't stack observers.
			if (!window.__giscusThemeObserver) {
				window.__giscusThemeObserver = true;
				var mo = new MutationObserver(function () {
					syncTheme();
				});
				mo.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
			}
		})();
	</script>
)}

<style is:global>
	/* Skeleton and widget share one grid cell: the widget fades in on top, so nothing below it moves. */
	.giscus-host {
		display: grid;
	}
	.giscus-host > * {
		grid-area: 1 / 1;
		min-width: 0;
	}
	/* Mirrors the empty widget (reactions, count, comment box) at its measured height: 372px at 375 and 1440 px. */
	.giscus-skeleton {
		display: flex;
		flex-direction: column;
		height: 372px;
		transition: opacity 0.2s ease;
	}
	.giscus-skeleton-reactions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.giscus-skeleton .giscus-skeleton-count {
		width: 15rem;
		max-width: 100%;
		height: 1.25rem;
		margin: 2.5rem 0 1.25rem;
	}
	.giscus-skeleton-box {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.5rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.375rem;
	}
	.giscus-skeleton-tabs {
		display: flex;
		gap: 0.25rem;
	}
	.giscus-skeleton-tabs .skeleton {
		width: 4.25rem;
		height: 2.25rem;
	}
	.giscus-skeleton .giscus-skeleton-input {
		flex: 1;
	}
	.giscus-skeleton .giscus-skeleton-button {
		width: 11.5rem;
		height: 2rem;
		margin-left: auto;
	}
	.giscus-host[data-loaded] .giscus-skeleton {
		opacity: 0;
		pointer-events: none;
	}
	.giscus-unavailable {
		font-size: 0.875rem;
		opacity: 0.6;
	}
	@media (prefers-reduced-motion: reduce) {
		.giscus-skeleton {
			transition: none;
		}
	}
</style>
