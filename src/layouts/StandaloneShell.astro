---
// The Astro shell for standalone pages (option E). A fragment (src/standalone/<kind>/<slug>/) supplies
// content only — body.html, page.css, page.js and meta.json; this shell supplies all the chrome: head,
// design-system bundle link, hero, tab bar, rails, and (via the shared applyChrome pipeline) the navbar,
// license footer, comments, breadcrumb, theme script and OG/canonical.
//
// Kind-agnostic: `kind` is a plain string (research, experiment, idea, …). The canonical URL is
// /<kind>/<slug>/, so renaming a kind is a folder move, not a shell change.
//
// The shell renders a complete standalone HTML document and hands it to the same applyChrome pipeline the
// old injection path uses, so the two paths stay uniform. The document is emitted with set:html on a Fragment: the string
// carries its own <!doctype html><html>, and wrapping it in <html> put the doctype inside that element (quirks mode).
import { buildScript } from "../chrome/navbar";
import { buildLicenseScript } from "../chrome/license";
import { applyChrome } from "../chrome/apply";
import { esc } from "../chrome/util";
import { themeRuntimeScript } from "../utils/theme-runtime";
import { iconNames, spriteBlock } from "../design-system/lucide";
import { DOC_ICONS, renderDoc } from "../design-system/shell/doc";
import type { Fragment } from "../standalone/loader";

// Human label for a kind, used as the hero eyebrow when the fragment has no eyebrow of its own.
const KIND_LABEL: Record<string, string> = { research: "Research", experiment: "Experiment", playground: "Playground", idea: "Idea", "design-system": "Design system" };
const kindLabel = (kind: string) => KIND_LABEL[kind] ?? kind;
// The section a page belongs to, by its URL segment: the Doc design links it from the sidebar brand.
const SECTION_LABEL: Record<string, string> = { research: "Research", playground: "Playground", ideas: "Ideas" };
// Where the Doc design departs from the references the conformance check compares with (the compact report template
// and the main post), and why. Rule ids are check:design-system's.
const DOC_ALLOW = [
	"typography-scale: the Doc design reads at the document template's comfortable sizes (16px body, 22px page headings), not the compact report template's",
	"rail-presence: in the Doc design a page's sections are the bar's nav; the right sidebar lists only the shown section's sub-headings, so it is empty when the section has none",
	"prose-type: the Doc design sets its prose in the design system's own type scale and ink colours (see typography-scale), not the main post's",
	"footer-box: the license card spans the document column (the navbar card's width, like the breadcrumb and the comments), not the main post's 872px column",
	"footer-type: the license is the site's small print on every standalone page (12px, muted), not the main post's footer text",
	"footer-gap: the click-to-load comments section sits between the document and the license card",
];

interface Props { kind: string; slug: string; segment: string; fragment: Fragment }
const { kind, slug, segment, fragment } = Astro.props;
const { meta, body, css, js, tabs } = fragment;
const site = Astro.site?.href ?? "";
const base = Astro.site ? Astro.site.pathname : "/";
// The URL segment is the route's directory name (ideas, research, playground) — not always the fragment
// kind (idea is singular, its route is src/pages/ideas/). The route passes its own segment.
const urlPath = `/${segment}/${slug}/`;

// The "· created · updated" stamp the shell renders from meta (the title carries no stamp of its own).
const stamp = ` · created ${meta.created} · updated ${meta.updated}`;
const title = `${meta.title}${stamp}`;

// Tab bar (contract: tabs come from the markup, derived by the loader). ?tab= is owned by rd.js, which
// mounts it on load via data-rd="tabs" (the fragment's page.js must not call rd.init, or it double-mounts).
const tabBar =
	meta.layout === "tabbed" && tabs.length
		? `<nav class="rd-expnav" role="tablist" aria-label="Sections" data-rd="tabs">` +
			tabs.map((t, i) => `<a role="tab" id="tab-${esc(t.id)}" href="?tab=${esc(t.id)}" aria-controls="${esc(t.id)}" aria-selected="${i === 0 ? "true" : "false"}">${t.icon ? `<svg class="rd-icon" aria-hidden="true"><use href="#i-${esc(t.icon)}"/></svg>` : ""}${esc(t.label)}</a>`).join("") +
			`</nav>`
		: "";

// The page's own styles, scoped and inlined (contract: page.css is <= 4 KB, every selector prefixed).
const pageCss = css ? `<style is:inline>${css}</style>` : "";

// The page's Lucide icons, inlined as a self-contained sprite (no request) — the shell-rendered
// fragment has no public/ page for the sprite builder to rewrite, so the shell supplies its own.
// meta.icons adds names the page creates in page.js (not referenced in the body markup), so they
// are in the sprite too; the union is deduped.
// Two designs for the same body (meta.shell): "card" (hero, tab bar, rail beside the content, on the content card) or
// "doc" (components/doc.css: page list in a left sidebar, sticky page bar, On this page in a right sidebar). A doc page
// needs tabs (its page list is the tabs); without them it falls back to card.
const isDoc = meta.shell === "doc" && tabs.length > 0;
const docBody = isDoc
	? renderDoc({
			slug,
			title: meta.title,
			summary: meta.summary,
			created: meta.created,
			updated: meta.updated,
			eyebrow: meta.eyebrow ?? kindLabel(kind),
			section: SECTION_LABEL[segment] ? { label: SECTION_LABEL[segment], href: `${base.replace(/\/$/, "")}/${segment}/` } : null,
			tabs,
			rails: fragment.rails,
			body,
			indexed: meta.search,
		})
	: "";
const sprite = spriteBlock([...new Set([...iconNames(isDoc ? docBody : tabBar + body), ...(isDoc ? DOC_ICONS : []), ...(meta.icons ?? [])])]);

// The page's runtime module (contract: export default init({ root, data, rd })). Served as a Vite asset
// (content-hashed, no public/ duplicate) and invoked by a tiny per-page module that hands it the root,
// the data and the rd runtime. rd.js (emitted first) has set window.rd by the time this runs.
const pageModules = import.meta.glob("/src/standalone/*/*/page.js", { query: "?url", import: "default", eager: true });
const pageJsUrl = pageModules[`/src/standalone/${kind}/${slug}/page.js`];
const pageJs = js
	? `<script type="module">import init from ${JSON.stringify(pageJsUrl)};\ninit({ root: document.querySelector('[data-page="${esc(slug)}"]'), data: null, rd: window.rd });</script>`
	: "";

// A complete standalone document, shaped like a generator's export so applyChrome treats it the same as a
// public/**/*.html page. The design-system bundle is linked (not inlined) so it stays current.
const doc =
	`<!doctype html>` +
	`<html lang="en" data-theme="light"${isDoc ? ` data-rd-host="site"` : ""}>` +
	`<head>` +
	`<meta charset="utf-8">` +
	`<meta name="viewport" content="width=device-width, initial-scale=1">` +
	`<title>${esc(title)}</title>` +
	`<meta name="description" content="${esc(meta.summary)}">` +
	// The Doc design differs from the Card design's references on purpose; the conformance check reads these as
	// documented exceptions (check:design-system, ds-allow), one place for every doc page.
	(isDoc ? DOC_ALLOW.map((a) => `<meta name="ds-allow" content="${esc(a)}">`).join("") : "") +
	`<link rel="stylesheet" href="/design-system/rd.css">` +
	// The JS layout (.js rules: the Doc grid and drawers) from the first paint. rd.js sets the same flag, but it is a
	// module and runs after first paint, so the no-JS layout would show first and then jump (a layout shift).
	`<script>document.documentElement.classList.add("js")</script>` +
	`<script data-site-theme>${themeRuntimeScript(true)}</script>` +
	`</head>` +
	`<body class="rd-body">` +
	`${sprite}` +
	(isDoc
		? docBody
		: `<main class="${meta.layout === "tabbed" ? "rd-tabbed " : ""}rd-container${meta.width === "wide" ? "--wide" : ""} rd-prose" data-page="${esc(slug)}" data-pagefind-body="${meta.search ? "" : "false"}">` +
			`<header class="rd-hero"><p class="rd-eyebrow">${esc(meta.eyebrow ?? kindLabel(kind))}</p><h1>${esc(meta.title)}<span class="rd-stamp"><span class="rd-stamp__sep"> · </span>created ${esc(meta.created)} · updated ${esc(meta.updated)}</span></h1><p class="rd-hero__lede">${esc(meta.summary)}</p></header>` +
			`${tabBar}` +
			`${body}` +
			`</main>`) +
	`${pageCss}` +
	`<script type="module" src="/design-system/rd.js"></script>` +
	`${pageJs}` +
	`</body>` +
	`</html>`;

// applyChrome adds the navbar, license footer, comments, breadcrumb band, theme sync and OG/canonical.
const html = applyChrome(doc, buildScript(base), "", buildLicenseScript(base), urlPath, base, site);
---
<Fragment set:html={html} />
