---
import EntryCards from "@components/EntryCards.astro";
import LicenseNote from "@components/LicenseNote.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import data from "../data/experiments.json";
import type { Entry } from "../types/entry";
---

<MainGridLayout title="Experiments" description="Live things you can play with.">
    <div class="card-base px-9 py-6 w-full">
        <h1 class="text-3xl font-bold text-90 mb-1">Experiments</h1>
        <p class="text-50 mb-6">Live things you can play with.</p>
        <EntryCards items={data.items as Entry[]} />
    </div>
    <LicenseNote class="mt-4" />
</MainGridLayout>
