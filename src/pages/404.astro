---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout hasOwnHeading title="Page not found" description="Page not found">
    <div class="card-base px-9 py-6 w-full">
        <h1 class="text-3xl font-bold text-90 mb-4">Page not found</h1>
        <p class="text-75 mb-6">That page does not exist or has moved. Start from the home page or browse the archive.</p>
        <div class="flex flex-wrap gap-3">
            <a href={url("/")} class="btn-regular rounded-lg h-11 px-5 inline-flex items-center font-bold">Home</a>
            <a href={url("/archive/")} class="btn-regular rounded-lg h-11 px-5 inline-flex items-center font-bold">Archive</a>
        </div>
    </div>
</MainGridLayout>
