#!/bin/sh
# managed-by: scripts/install-hooks.sh
# Blocks commits that stage secrets: risky filenames + gitleaks scan of the staged diff.
# Bypass (don't): git commit --no-verify
set -u
. "$(dirname "$0")/_common.sh"

run_local_hook pre-commit "$@" || exit 1

blocked=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '(^|/)(\.env(\..+)?|\.npmrc\.local|id_(rsa|dsa|ecdsa|ed25519)(\.pub)?|.*\.(pem|key|p12|pfx|jks|keystore|ovpn)|\.netrc|credentials(\.json)?|service-account.*\.json)$' | grep -vE '\.(example|sample|template)$' || true)
if [ -n "$blocked" ]; then
	echo "pre-commit: refusing to commit sensitive-looking files:" >&2
	echo "$blocked" | sed 's/^/  - /' >&2
	echo "Unstage them (git restore --staged <file>) and add to .gitignore." >&2
	exit 1
fi

run_gitleaks git --staged $(repo_config | tr '\n' ' ') || {
	echo "pre-commit: possible secret in staged changes. Remove it; rotate it if it was real." >&2
	exit 1
}

# Design-system bundle: the shipped public/design-system/{rd.css,research.css,rd.js,manifest.json} must
# equal a fresh build of src/design-system/. If you edited the sources, run `pnpm build:design-system` and re-stage.
ds=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(src/design-system/|public/design-system/(rd\.css|research\.css|rd\.js|manifest\.json)$|scripts/build-design-system\.mjs$)' || true)
if [ -n "$ds" ]; then
	node scripts/build-design-system.mjs --check || {
		echo "pre-commit: design-system bundle is stale. Run 'pnpm build:design-system' and re-stage the outputs." >&2
		exit 1
	}
fi

# Lucide sprite: the shipped public/design-system/lucide-sprite.svg and each page's inlined sprite block
# must equal a fresh build of the pages' icon references. If you added an icon, run `pnpm build` and re-stage.
sp=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(public/(design-system|research|ideas)/|scripts/build-lucide-sprite\.mjs$)' || true)
if [ -n "$sp" ]; then
	node scripts/build-lucide-sprite.mjs --check || {
		echo "pre-commit: Lucide sprite is stale. Run 'pnpm build' and re-stage the sprite." >&2
		exit 1
	}
fi
