#!/bin/sh
# managed-by: scripts/install-hooks.sh
# Blocks pushes that would publish a secret in any commit not already on the remote.
# Bypass (don't): git push --no-verify
set -u
. "$(dirname "$0")/_common.sh"
zero=0000000000000000000000000000000000000000
remote_name=${1:-}
input=$(cat)

printf '%s\n' "$input" | run_local_hook pre-push "$@" || exit 1

printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$local_ref" = refs/heads/dev/next ] || [ "$remote_ref" = refs/heads/dev/next ]; then
		echo "pre-push: refusing to push dev/next. It is a local-only mirror of origin/master and is never pushed (see CLAUDE.md)." >&2
		exit 1
	fi
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	if [ "$remote_sha" = "$zero" ]; then
		# New branch: skip only commits already on the push destination; if it can't be identified,
		# scan the full history rather than trusting unrelated remotes.
		if [ -n "$remote_name" ] && git remote get-url "$remote_name" >/dev/null 2>&1; then
			range="$local_sha --not --remotes=$remote_name"
		else
			range="$local_sha"
		fi
	else
		range="$remote_sha..$local_sha"
	fi
	# --diff-merges: include merge-commit patches (git omits them by default).
	run_gitleaks git $(repo_config | tr '\n' ' ') --log-opts="--diff-merges=first-parent $range" || {
		echo "pre-push: possible secret in commits being pushed to $remote_ref." >&2
		echo "Remove it from history (amend/rebase); rotate it if it was real; push again." >&2
		exit 1
	}
done
