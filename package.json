{
  "name": "ningsuhen-github-io",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:agent": "astro dev --port 4400",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "prebuild": "node scripts/build-lucide-sprite.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm",
    "prepare": "sh scripts/install-hooks.sh",
    "check:standalone": "node scripts/check-standalone-pages.mjs",
    "check:report-history": "node scripts/check-report-history.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:thumbnails": "node scripts/check-thumbnails.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:leaks": "node scripts/check-public-leaks.mjs",
    "test:tts": "node --experimental-strip-types --test scripts/tts-normalize.test.ts",
    "check:listen": "node scripts/check-listen.mjs",
    "check:kokoro": "node scripts/check-kokoro.mjs",
    "new-experiment": "node scripts/new-experiment.mjs",
    "new-research": "node scripts/new-experiment.mjs --research",
    "sync": "sh scripts/sync-dev-next.sh",
    "merge-pr": "sh scripts/merge-pr.sh",
    "test:hooks": "sh scripts/test-pre-push.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "7.2.3",
    "@astrojs/tailwind": "^6.0.2",
    "@expressive-code/core": "^0.41.4",
    "@expressive-code/plugin-collapsible-sections": "^0.41.4",
    "@expressive-code/plugin-line-numbers": "^0.41.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@iconify-icons/lucide": "^2.0.23",
    "@iconify-json/fa6-brands": "1.2.6",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify/svelte": "^4.2.0",
    "@swup/astro": "^1.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "7.3.3",
    "astro-expressive-code": "^0.41.4",
    "astro-icon": "^1.1.5",
    "hastscript": "^9.0.1",
    "katex": "^0.18.2",
    "markdown-it": "^14.3.3",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.12.0",
    "pagefind": "^1.4.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stylus": "^0.64.0",
    "svelte": "^5.39.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/ts-plugin": "^1.10.6",
    "@biomejs/biome": "2.2.5",
    "@iconify-json/lucide": "^1.2.147",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/hast": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.0",
    "axe-core": "4.10.2",
    "playwright-core": "^1.64.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2"
  },
  "packageManager": "pnpm@9.14.4"
}
